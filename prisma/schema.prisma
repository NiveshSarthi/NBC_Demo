// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  agent
  admin
  builder
  buyer
  seller
}

enum PropertyType {
  residential
  commercial
  plot
  religious
}

enum PriceUnit {
  INR
  USD
}

enum AreaUnit {
  sqft
  sqm
  acre
  hectare
}

enum Furnishing {
  unfurnished
  semi_furnished
  fully_furnished
}

enum OwnershipType {
  freehold
  leasehold
  cooperative
}

enum PossessionStatus {
  ready_to_move
  under_construction
  new_launch
}

enum PropertyStatus {
  active
  sold
  rented
  inactive
}

enum ListingType {
  sale
  rent
}

enum RentPeriod {
  daily
  monthly
  yearly
}

enum LocationType {
  primary
  secondary
  emerging
}

enum TierClassification {
  tier1
  tier2
  tier3
}

enum ImageType {
  exterior
  interior
  amenity
  location
  floor_plan
}

enum EventType {
  view
  inquiry
  save
  share
  contact
}

enum PredictionType {
  price_forecast
  investment_score
  roi_analysis
}

enum InquiryType {
  general
  price
  availability
  visit
}

enum InquiryStatus {
  new
  responded
  closed
}

enum ReraApprovalStatus {
  approved
  pending
  not_registered
}

enum CallType {
  masked
  direct
}

enum CallStatus {
  scheduled
  initiated
  completed
  missed
}

enum LoanStatus {
  draft
  submitted
  approved
  rejected
}

enum OfferType {
  festival
  builder
  seasonal
  limited_time
}

enum ViewingStatus {
  scheduled
  confirmed
  completed
  cancelled
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal_sent
  negotiation
  won
  lost
  archived
}

enum LeadSource {
  website
  referral
  social_media
  advertisement
  cold_call
  email_campaign
  other
}

enum CampaignType {
  email
  sms
  social_media
  banner
  promotion
  discount
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  cancelled
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password_hash     String
  first_name        String?
  last_name         String?
  phone             String?
  role              UserRole @default(user)
  avatar_url        String?
  preferences       Json?
  email_verified    Boolean  @default(false)
  phone_verified    Boolean  @default(false)
  investment_budget Decimal? @db.Decimal(15, 2)
  preferred_locations String[]
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  last_login        DateTime?

  // Relations
    properties           Property[] @relation("CreatedBy")
    analytics            Analytic[]
    searches             UserSearch[]
    inquiries            Inquiry[]
    responded_inquiries  Inquiry[] @relation("RespondedBy")
    payments             Payment[]
    calls                Call[] @relation("UserCalls")
    agent_calls          Call[] @relation("AgentCalls")
    loan_applications    LoanApplication[]
    saved_properties     SavedProperty[]
    saved_searches       SavedSearch[]
    property_reviews     PropertyReview[]
    forum_posts          CommunityForumPost[]
    viewing_schedules    ViewingScheduler[]
    created_campaigns    Campaign[]
    assigned_leads       Lead[] @relation("LeadAssignee")
    leads                Lead[]
  
    @@map("users")
  }
  
  model Builder {
    id                    Int      @id @default(autoincrement())
    name                  String
    history               String
    past_projects         Json     // Array of project objects with name, completion_date, location
    delivery_track_record Json     // Object with completed_projects_count, on_time_delivery_rate, customer_satisfaction_rating
    ratings               Decimal  @db.Decimal(3, 1)
    financial_stability   Json     // Object with revenue, profit_margin, debt_ratio
    awards                String[]
    created_at            DateTime @default(now())
    updated_at            DateTime @updatedAt
  
    // Relations
    properties           Property[]
    leads                Lead[]
    campaigns            Campaign[]
    analytics            BuilderAnalytics[]
  
    @@map("builders")
  }
  
  model Property {
    id                 Int          @id @default(autoincrement())
    slug               String?      @unique
    title              String
    description        String?
  property_type      PropertyType
  sub_type           String?
  listing_type       ListingType  @default(sale)
  location_id        Int?
  address            String?
  city               String?
  state              String?
  pincode            String?
  latitude           Decimal?     @db.Decimal(10, 8)
  longitude          Decimal?     @db.Decimal(11, 8)
  price              Decimal?     @db.Decimal(15, 2)
  rent_amount        Decimal?     @db.Decimal(15, 2)
  rent_period        RentPeriod   @default(monthly)
  price_unit         PriceUnit    @default(INR)
  area               Decimal?     @db.Decimal(10, 2)
  area_unit          AreaUnit     @default(sqft)
  bedrooms           Int?
  bathrooms          Int?
  parking_spaces     Int?
  floor_number       Int?
  total_floors       Int?
  year_built         Int?
  furnishing         Furnishing?
  amenities          String[]
  features           String[]
  rera_registered    Boolean      @default(false)
  rera_number        String?
  ownership_type     OwnershipType?
  possession_status  PossessionStatus?
  possession_date    DateTime?
  builder_id         Int?
  developer_name     String?
  project_name       String?
  virtual_tour_url   String?
  video_tour_url     String?
  drone_footage_url  String?
  time_lapse_url     String?
  ai_score           Decimal?     @db.Decimal(5, 2)
  ai_prediction      Json?
  religious_significance String?
  infrastructure_impact Json?
  floor_plan_url     String?
  three_d_tour_url   String?
  vastu_compliant    Boolean      @default(false)
  orientation        String?
  carpet_area        Decimal?     @db.Decimal(10, 2)
  built_up_area      Decimal?     @db.Decimal(10, 2)
  status             PropertyStatus @default(active)
  featured           Boolean      @default(false)
  premium_listing    Boolean      @default(false)
  views_count        Int          @default(0)
  inquiries_count    Int          @default(0)
  created_by         Int?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  gift_pack          Json?
  highlight_types    String[]
  price_drop_amount  Decimal?     @db.Decimal(15, 2)
  is_new_launch      Boolean      @default(false)
  units_left         Int?
  last_updated_price DateTime?

  // Relations
    location           Location?            @relation(fields: [location_id], references: [id])
    creator            User?                @relation("CreatedBy", fields: [created_by], references: [id])
    builder            Builder?             @relation(fields: [builder_id], references: [id])
    images             PropertyImage[]
    analytics          Analytic[]
    predictions        AiPrediction[]
    inquiries          Inquiry[]
    reraCompliance     ReraCompliance?
    calls              Call[]
    loan_applications  LoanApplication[]
    saved_properties   SavedProperty[]
    property_reviews   PropertyReview[]
    forum_posts        CommunityForumPost[]
    viewing_schedules  ViewingScheduler[]
    leads              Lead[]
  
    @@map("properties")
}

model ReraCompliance {
  id                    Int                @id @default(autoincrement())
  property_id           Int                @unique
  registration_number   String
  approval_status       ReraApprovalStatus
  complaint_history     Json // Array of complaint objects with date, type, status
  project_timeline      Json // Array of milestone objects with date, event, completed
  approved_building_plans String[]
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  // Relations
  property              Property           @relation(fields: [property_id], references: [id])

  @@map("rera_compliance")
}

model Location {
  id                   Int             @id @default(autoincrement())
  name                 String
  city                 String?
  state                String?
  district             String?
  type                 LocationType    @default(secondary)
  latitude             Decimal?        @db.Decimal(10, 8)
  longitude            Decimal?        @db.Decimal(11, 8)
  population           BigInt?
  area_sqkm            Decimal?        @db.Decimal(10, 2)
  gdp_per_capita       Decimal?        @db.Decimal(10, 2)
  growth_rate          Decimal?        @db.Decimal(5, 2)
  master_plan_url      String?
  master_plan_data     Json?
  infrastructure_projects Json?
  religious_sites      Json?
  airport_distance_km  Decimal?        @db.Decimal(8, 2)
  metro_distance_km    Decimal?        @db.Decimal(8, 2)
  expressway_distance_km Decimal?      @db.Decimal(8, 2)
  smart_city_status    Boolean         @default(false)
  tier_classification  TierClassification?
  investment_potential Decimal?        @db.Decimal(3, 1)
  amenities            Json?
  connectivity_score   Json?
  locality_highlights   Json?
  essential_services    Json?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  // Relations
  properties          Property[]

  @@map("locations")
}

model PropertyImage {
  id          Int        @id @default(autoincrement())
  property_id Int
  image_url   String
  alt_text    String?
  is_primary  Boolean    @default(false)
  sort_order  Int        @default(0)
  image_type  ImageType?
  created_at  DateTime   @default(now())

  // Relations
  property    Property   @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_images")
}

model Analytic {
  id          Int       @id @default(autoincrement())
  property_id Int?
  event_type  EventType
  user_id     Int?
  session_id  String?
  ip_address  String?   @db.Inet
  user_agent  String?
  referrer_url String?
  timestamp   DateTime  @default(now())

  // Relations
  property    Property? @relation(fields: [property_id], references: [id])
  user        User?     @relation(fields: [user_id], references: [id])

  @@map("analytics")
}

model AiPrediction {
  id               Int           @id @default(autoincrement())
  property_id      Int
  prediction_type  PredictionType
  predicted_value  Decimal       @db.Decimal(15, 2)
  confidence_score Decimal       @db.Decimal(5, 2)
  prediction_date  DateTime      @default(now())
  valid_until      DateTime?
  factors          Json?
  model_version    String?
  created_at       DateTime      @default(now())

  // Relations
  property         Property      @relation(fields: [property_id], references: [id])

  @@map("ai_predictions")
}

model UserSearch {
  id           Int      @id @default(autoincrement())
  user_id      Int
  search_query String?
  filters      Json?
  location_bounds Json?
  results_count Int?
  timestamp    DateTime @default(now())

  // Relations
  user         User     @relation(fields: [user_id], references: [id])

  @@map("user_searches")
}

model Inquiry {
  id            Int           @id @default(autoincrement())
  property_id   Int
  user_id       Int?
  name          String?
  email         String?
  phone         String?
  message       String
  inquiry_type  InquiryType   @default(general)
  status        InquiryStatus @default(new)
  response      String?
  responded_by  Int?
  responded_at  DateTime?
  is_anonymous  Boolean       @default(false)
  messages      Json?
  created_at    DateTime      @default(now())

  // Relations
  property      Property      @relation(fields: [property_id], references: [id])
  user          User?         @relation(fields: [user_id], references: [id])
  responder     User?         @relation("RespondedBy", fields: [responded_by], references: [id])

  @@map("inquiries")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentType {
  premium_listing
  featured_listing
  property_report
  virtual_tour
  consultation
}

model Payment {
  id                Int           @id @default(autoincrement())
  user_id           Int
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  payment_type      PaymentType
  status            PaymentStatus @default(pending)
  razorpay_order_id String?
  razorpay_payment_id String?
  description       String?
  metadata          Json?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  // Relations
  user              User          @relation(fields: [user_id], references: [id])

  @@map("payments")
}

model Call {
 id               Int         @id @default(autoincrement())
 user_id          Int?
 property_id      Int
 agent_id         Int
 call_type        CallType
 status           CallStatus
 duration_seconds Int?
 recording_url    String?
 scheduled_at     DateTime?
 created_at       DateTime    @default(now())

 // Relations
 user             User?       @relation("UserCalls", fields: [user_id], references: [id])
 property         Property    @relation(fields: [property_id], references: [id])
 agent            User        @relation("AgentCalls", fields: [agent_id], references: [id])

 @@map("calls")
}

model Bank {
 id                  Int      @id @default(autoincrement())
 name                String
 interest_rates      Json
 eligibility_criteria Json
 logo_url            String
 contact_info        Json
 created_at          DateTime @default(now())
 updated_at          DateTime @updatedAt

 // Relations
 loan_applications   LoanApplication[]

 @@map("banks")
}

model LoanApplication {
 id             Int         @id @default(autoincrement())
 user_id        Int
 property_id    Int?
 bank_id        Int
 loan_amount    Decimal     @db.Decimal(15, 2)
 status         LoanStatus  @default(draft)
 documents      Json        // array of document objects
 created_at     DateTime    @default(now())
 updated_at     DateTime    @updatedAt

 // Relations
 user           User        @relation(fields: [user_id], references: [id])
 property       Property?   @relation(fields: [property_id], references: [id])
 bank           Bank        @relation(fields: [bank_id], references: [id])

 @@map("loan_applications")
}

model SavedProperty {
 id          Int      @id @default(autoincrement())
 user_id     Int
 property_id Int
 added_at    DateTime @default(now())
 shared_with Int[]
 is_public   Boolean  @default(false)

 // Relations
 user     User     @relation(fields: [user_id], references: [id])
 property Property @relation(fields: [property_id], references: [id])

 @@map("saved_properties")
}

model SavedSearch {
 id               Int      @id @default(autoincrement())
 user_id          Int
 name             String
 search_query     String?
 filters          Json?
 location_bounds  Json?
 alert_enabled    Boolean  @default(false)
 last_alert_sent  DateTime?
 created_at       DateTime @default(now())
 updated_at       DateTime @updatedAt

 // Relations
 user User @relation(fields: [user_id], references: [id])

 @@map("saved_searches")
}

model PropertyReview {
 id          Int     @id @default(autoincrement())
 user_id     Int
 property_id Int
 rating      Int     // 1-5
 review_text String?
 created_at  DateTime @default(now())

 // Relations
 user     User     @relation(fields: [user_id], references: [id])
 property Property @relation(fields: [property_id], references: [id])

 @@map("property_reviews")
}

model CommunityForumPost {
 id          Int      @id @default(autoincrement())
 user_id     Int
 property_id Int?
 title       String
 content     String
 replies     Json?    // array of reply objects with user_id, content, created_at
 created_at  DateTime @default(now())
 updated_at  DateTime @updatedAt

 // Relations
 user     User      @relation(fields: [user_id], references: [id])
 property Property? @relation(fields: [property_id], references: [id])

 @@map("community_forum_posts")
}

model ViewingScheduler {
 id          Int           @id @default(autoincrement())
 user_id     Int
 property_id Int
 scheduled_at DateTime
 status      ViewingStatus @default(scheduled)
 notes       String?
 created_at  DateTime      @default(now())
 updated_at  DateTime      @updatedAt

 // Relations
 user     User     @relation(fields: [user_id], references: [id])
 property Property @relation(fields: [property_id], references: [id])

 @@map("viewing_schedules")
}

model Offer {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  image_url   String
  link_url    String?
  type        OfferType
  is_active   Boolean   @default(true)
  start_date  DateTime
  end_date    DateTime?
  priority    Int       @default(1)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("offers")
}

model Lead {
  id              Int         @id @default(autoincrement())
  builder_id      Int
  property_id     Int?
  user_id         Int?
  name            String
  email           String
  phone           String
  status          LeadStatus  @default(new)
  source          LeadSource  @default(website)
  budget_min      Decimal?    @db.Decimal(15, 2)
  budget_max      Decimal?    @db.Decimal(15, 2)
  preferred_location String?
  requirements    String?
  notes           String?
  last_contacted  DateTime?
  next_followup   DateTime?
  assigned_to     Int?        // builder user id
  tags            String[]
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  // Relations
  builder         Builder     @relation(fields: [builder_id], references: [id])
  property        Property?   @relation(fields: [property_id], references: [id])
  user            User?       @relation(fields: [user_id], references: [id])
  assignee        User?       @relation("LeadAssignee", fields: [assigned_to], references: [id])

  @@map("leads")
}

model Campaign {
  id              Int           @id @default(autoincrement())
  builder_id      Int
  title           String
  description     String?
  type            CampaignType
  status          CampaignStatus @default(draft)
  target_audience Json          // filters for targeting leads/prospects
  budget          Decimal?      @db.Decimal(10, 2)
  start_date      DateTime?
  end_date        DateTime?
  content         Json          // campaign content (email template, banner, etc.)
  metrics         Json          // performance metrics
  created_by      Int
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  // Relations
  builder         Builder       @relation(fields: [builder_id], references: [id])
  creator         User          @relation(fields: [created_by], references: [id])

  @@map("campaigns")
}

model BuilderAnalytics {
  id                  Int      @id @default(autoincrement())
  builder_id          Int
  metric_type         String   // revenue, leads, conversions, engagement
  metric_value        Decimal  @db.Decimal(15, 2)
  period_start        DateTime
  period_end          DateTime
  breakdown           Json?    // additional breakdown data
  created_at          DateTime @default(now())

  // Relations
  builder             Builder  @relation(fields: [builder_id], references: [id])

  @@map("builder_analytics")
}
